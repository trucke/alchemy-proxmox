{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitThis": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["node_modules", "packages/*/lib"]
}
